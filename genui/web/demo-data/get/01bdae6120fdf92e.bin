he Kit holds no textbook text; a Plan's citations decide its label)\",reference:[{args:{refractive_index:1},expected:90,tolerance:1e-9,derivation:\"sin c = 1, so c = 90 degrees (no bending, no total internal reflection)\"},{args:{refractive_index:1.4142135624},expected:45,tolerance:1e-6,derivation:\"sin c = 1 / sqrt2 = sqrt2 / 2, so c = 45 degrees\"},{args:{refractive_index:2},expected:30,tolerance:1e-9,derivation:\"sin c = 1/2, so c = 30 degrees\"},{args:{refractive_index:1.49},expected:42.1552,tolerance:5e-4,derivation:\"sin c = 1 / 1.49 = 0.67114; c = 42.16 degrees (the glass prism of a worked example)\"},{args:{refractive_index:1.5},expected:41.8103,tolerance:5e-4,derivation:\"sin c = 1 / 1.5 = 0.66667; c = 41.81 degrees (glass)\"},{args:{refractive_index:1.33},expected:48.7535,tolerance:5e-4,derivation:\"sin c = 1 / 1.33 = 0.75188; c = 48.75 degrees (water)\"},{args:{refractive_index:2.42},expected:24.4075,tolerance:5e-4,derivation:\"sin c = 1 / 2.42 = 0.41322; c = 24.41 degrees (diamond)\"}],properties:[{kind:\"finite\"},{kind:\"non_negative\"},{kind:\"decreasing\",arg:\"refractive_index\"}],grid:{refractive_index:[1,1.33,1.49,1.5,2.42]}};function ni(e){return F(tr,{},{refractive_index:e.refractive_index})}var nr={id:\"physics.specific_heat\",exportName:\"specificHeat\",inputs:{mass:{unit:\"kg\",min:0,exclusive:!0},temperature_change:{unit:\"\\xB0C\",min:0}},params:{specific_heat:{unit:\"J/kg\\xB0C\",min:0,exclusive:!0}},output:{unit:\"J\"},fn:({mass:e,temperature_change:t,specific_heat:n})=>e*n*t,citation:\"UNVERIFIED (the Kit holds no textbook text; a Plan's citations decide its label)\",reference:[{args:{mass:1,temperature_change:1,specific_heat:4200},expected:4200,tolerance:1e-9,derivation:\"1 kg of water by 1 degree needs c = 4 200 J\"},{args:{mass:2,temperature_change:50,specific_heat:4200},expected:42e4,tolerance:1e-6,derivation:\"2 x 4 200 x 50 = 420 000 J\"},{args:{mass:.5,temperature_change:40,specific_heat:900},expected:18e3,tolerance:1e-6,derivation:\"0.5 x 900 x 40 = 18 000 J (aluminium)\"},{args:{mass:3,temperature_change:20,specific_heat:390},expected:23400,tolerance:1e-6,derivation:\"3 x 390 x 20 = 23 400 J (copper)\"},{args:{mass:.25,temperature_change:8,specific_heat:2100},expected:4200,tolerance:1e-6,derivation:\"0.25 x 2 100 x 8 = 4 200 J (paraffin)\"},{args:{mass:4,temperature_change:0,specific_heat:4200},expected:0,tolerance:1e-9,derivation:\"no change of temperature needs no heat\"}],properties:[{kind:\"finite\"},{kind:\"non_negative\"},{kind:\"increasing\",arg:\"mass\"},{kind:\"increasing\",arg:\"temperature_change\"},{kind:\"increasing\",arg:\"specific_heat\"},{kind:\"homogeneous\",arg:\"mass\",degree:1},{kind:\"homogeneous\",arg:\"temperature_change\",degree:1},{kind:\"homogeneous\",arg:\"specific_heat\",degree:1}],grid:{mass:[.25,.5,2,4],temperature_change:[1,8,40,50],specific_heat:[390,900,2100,4200]}};function ri(e){return F(nr,{specific_heat:e.specific_heat},{mass:e.mass,temperature_change:e.temperature_change})}var rr={id:\"physics.transformer_voltage\",exportName:\"transformerVoltage\",inputs:{primary_turns:{unit:\"turns\",min:0,exclusive:!0},secondary_turns:{unit:\"turns\",min:0,exclusive:!0}},params:{primary_voltage:{unit:\"V\",min:0,exclusive:!0}},output:{unit:\"V\"},fn:({primary_turns:e,secondary_turns:t,primary_voltage:n})=>n*t/e,citation:\"UNVERIFIED (the Kit holds no textbook text; a Plan's citations decide its label)\",reference:[{args:{primary_turns:800,secondary_turns:60,primary_voltage:240},expected:18,tolerance:1e-9,derivation:\"240 x 60 / 800 = 18 V (step-down)\"},{args:{primary_turns:100,secondary_turns:500,primary_voltage:12},expected:60,tolerance:1e-9,derivation:\"12 x 500 / 100 = 60 V (step-up)\"},{args:{primary_turns:400,secondary_turns:400,primary_voltage:9},expected:9,tolerance:1e-9,derivation:\"equal turns leave the voltage unchanged\"},{args:{primary_turns:50,secondary_turns:1e3,primary_voltage:6},expected:120,tolerance:1e-9,derivation:\"6 x 1 000 / 50 = 120 V\"},{arg