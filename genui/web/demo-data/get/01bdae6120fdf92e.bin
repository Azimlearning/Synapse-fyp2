args:{h_conc:1e-7},expected:7,tolerance:1e-9,derivation:\"10^-7, so pH 7 (pure water)\"},{args:{h_conc:1},expected:0,tolerance:1e-9,derivation:\"1 = 10^0, so pH 0\"},{args:{h_conc:.01},expected:2,tolerance:1e-9,derivation:\"0.01 = 10^-2, so pH 2\"},{args:{h_conc:.002},expected:2.69897,tolerance:1e-5,derivation:\"2 x 10^-3: pH = 3 - log10(2) = 3 - 0.30103 = 2.69897\"},{args:{h_conc:3e-8},expected:7.52288,tolerance:1e-5,derivation:\"3 x 10^-8: pH = 8 - log10(3) = 8 - 0.47712 = 7.52288 (above 7, a weak alkali side)\"}],properties:[{kind:\"finite\"},{kind:\"decreasing\",arg:\"h_conc\"}],grid:{h_conc:[1e-9,1e-7,1e-4,.001,.01,.1,1]}};function Za(e){return F(Qn,{},{h_conc:e.h_conc})}var Zn={id:\"chemistry.gas_volume\",exportName:\"gasVolume\",inputs:{moles:{unit:\"mol\",min:0}},params:{molar_volume:{unit:\"dm3/mol\",min:0,exclusive:!0}},output:{unit:\"dm3\"},fn:({moles:e,molar_volume:t})=>e*t,citation:\"UNVERIFIED (the Kit holds no textbook text; a Plan's citations decide its label)\",reference:[{args:{moles:2,molar_volume:24},expected:48,tolerance:1e-9,derivation:\"2 mol x 24 dm3/mol = 48 dm3\"},{args:{moles:.5,molar_volume:22.4},expected:11.2,tolerance:1e-9,derivation:\"0.5 x 22.4 = 11.2 dm3\"},{args:{moles:1,molar_volume:24},expected:24,tolerance:1e-9,derivation:\"1 x 24 = 24 dm3\"},{args:{moles:0,molar_volume:24},expected:0,tolerance:1e-9,derivation:\"no gas, no volume\"},{args:{moles:.25,molar_volume:24},expected:6,tolerance:1e-9,derivation:\"0.25 x 24 = 6 dm3\"}],properties:[{kind:\"finite\"},{kind:\"non_negative\"},{kind:\"increasing\",arg:\"moles\"},{kind:\"increasing\",arg:\"molar_volume\"},{kind:\"homogeneous\",arg:\"moles\",degree:1}],grid:{moles:[.1,.5,1,2,5],molar_volume:[22.4,24]}};function ei(e){return F(Zn,{molar_volume:e.molar_volume},{moles:e.moles})}var er={id:\"physics.refraction_angle\",exportName:\"refractionAngle\",inputs:{incidence_angle:{unit:\"deg\",min:0,max:90,maxExclusive:!0},refractive_index:{unit:\"ratio\",min:1}},params:{},output:{unit:\"deg