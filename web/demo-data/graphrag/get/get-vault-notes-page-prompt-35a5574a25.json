ention","relation":null,"direction":null,"citationId":"c30","passages":2},{"other":{"id":"edge","label":"edges"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c31","passages":2}],"linksLeftOut":118,"claims":[{"citationId":"c32","pages":[{"id":"prompt","label":"prompt"}]}],"mentions":[{"citationId":"c33"},{"citationId":"c34"},{"citationId":"c3"},{"citationId":"c35"},{"citationId":"c24"},{"citationId":"c36"},{"citationId":"c37"},{"citationId":"c38"},{"citationId":"c39"},{"citationId":"c40"}],"mentionsLeftOut":118,"citations":[{"id":"c1","chunkId":"6c24762a3f277fd1_c_406b010c9a057b34","docId":"6c24762a3f277fd1","docTitle":"2309.15217_Ragas_Automated_Evaluation_of_Retrieval_Augmented_Generation","page":2,"quote":"For instance, GPTScore (Fu et al., 2023) uses a prompt that specifies the consid- ered aspect (e.g."},{"id":"c2","chunkId":"01d82c67ac18ffc3_c_491488cd4449b278","docId":"01d82c67ac18ffc3","docTitle":"2404.03868_Extract_Define_Canonicalize_An_LLM_based_Framework_for_Knowledge_Graph","page":3,"quote":"The success of large language models (LLMs) has pushed this paradigm further: current methods directly prompt the LLMs to generate triplets in a zero/few-shot manner."},{"id":"c3","chunkId":"396a0fadeb4cd40f_c_fab306facd5b5f68","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":2,"quote":"These articles, combined with the original question, form a comprehensive prompt that empowers LLMs to generate a well-informed answer."},{"id":"c4","chunkId":"396a0fadeb4cd40f_c_6c116d647bbfcc05","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":5,"quote":"Among the optimization methods for LLMs, RAG is often compared with Fine-tuning (FT) and prompt engineering."},{"id":"c5","chunkId":"396a0fadeb4cd40f_c_3fa0659d7f419fcb","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":3,"quote":"These chunks are subsequently used as the expanded context in prompt."},{"id":"c6","chunkId":"737b0b8fe0aa8459_c_66a82cdc8c692609","docId":"737b0b8fe0aa8459","docTitle":"2501.00309_Retrieval_Augmented_Generation_with_Graphs_GraphRAG","page":15,"quote":"A single fact is verbalized in the generation prompt as the tuple (entity 1, relation 1, entity 2) [308, 395]."},{"id":"c7","chunkId":"14671c78fc7de99d_c_2428bbb77a4838ab","docId":"14671c78fc7de99d","docTitle":"2405.14831_HippoRAG_Neurobiologically_Inspired_Long_Term_Memory_for_Large_Languag","page":29,"quote":"{\"named_entities\": [\"First for Women\", \"Arthur’s Magazine\"]} Input: Question: QUERY TO INDEX Query NER (Retrieval) Figure 8: Prompt for query NER during retrieval."},{"id":"c8","chunkId":"396a0fadeb4cd40f_c_3fa0659d7f419fcb","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":3,"quote":"The posed query and selected documents are synthesized into a coherent prompt to which a large language model is tasked with formulating a response."},{"id":"c9","chunkId":"14671c78fc7de99d_c_91d69c7850715a51","docId":"14671c78fc7de99d","docTitle":"2405.14831_HippoRAG_Neurobiologically_Inspired_Long_Term_Memory_for_Large_Languag","page":29,"quote":"For multi-step retrieval, we use the same prompt implementation as IRCoT [78] and retrieve the top-10 passages at each step."},{"id":"c10","chunkId":"14671c78fc7de99d_c_be272218a1710e9a","docId":"14671c78fc7de99d","docTitle":"2405.14831_HippoRAG_Neurobiologically_Inspired_Long_Term_Memory_for_Large_Languag","page":9,"quote":"More recent works use LLMs and introduce knowledge graph triples directly into the LLM prompt [57, 43, 47]."},{"id":"c11","chunkId":"01d82c67ac18ffc3_c_565b7707a80ea104","docId":"01d82c67ac18ffc3","docTitle":"2404.03868_Extract_Define_Canonicalize_An_LLM_based_Framework_for_Knowledge_Graph","page":2,"quote":"However, these methods are currently limited to small and domain-specific scenarios — to ensure the validity of generated triplets, schema informa- tion (e.g., possible entity and relation types) has to be included in the prompt."},{"id":"c12","chunkId":"6c24762a3f277fd1_c_47a6864421c44f0e","docId":"6c24762a3f277fd1","docTitle":"2309.15217_Ragas_Automated_Evaluation_of_Retrieval_Augmented_Generation","page":4,"quote":"For each of the 50 pages, we then asked ChatGPT to suggest a question that can be answered based on the introductory section of the page, using the following prompt: Your task is to formulate a question from given context satisfying the"},{"id":"c13","chunkId":"743155d9b0541c99_c_d663c85b73fa2c6c","docId":"743155d9b0541c99","docTitle":"2401.15391_MultiHop_RAG_Benchmarking_Retrieval_Augmented_Generation_for_Multi_Hop","page":4,"quote":"Appendix A presents the prompt used for GPT-4 for claim generation."},{"id":"c14","chunkId":"396a0fadeb4cd40f_c_2185ad1e9a647f92","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":14,"quote":"[54] analyze which type of documents should be retrieved, evaluate the relevance of the documents to the prompt, their position, and the number included in the context."},{"id":"c15","chunkId":"01d82c67ac18ffc3_c_3f7fee483c85589e","docId":"01d82c67ac18ffc3","docTitle":"2404.03868_Extract_Define_Canonicalize_An_LLM_based_Framework_for_Knowledge_Graph","page":2,"quote":"To further improve performance, the three steps above can be followed by an additional Refine- ment phase: we repeat EDC but provide the pre- viously extracted triplets and a relevant part of the schema in the prompt during the initial"},{"id":"c16","chunkId":"01d82c67ac18ffc3_c_491488cd4449b278","docId":"01d82c67ac18ffc3","docTitle":"2404.03868_Extract_Define_Canonicalize_An_LLM_based_Framework_for_Knowledge_Graph","page":3,"quote":"As previously mentioned, these models face difficulties scaling up to general text common in many real-world applications as the KG schema has to be included in the LLM prompt."},{"id":"c17","chunkId":"730f1a9f38d16689_c_49909d6a6c4b2105","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":2,"quote":"RAG is ideal when the total number of records in a data source is too large to include in a single prompt to the LLM, i.e."},{"id":"c18","chunkId":"01d82c67ac18ffc3_c_ab4c9837b1bf7083","docId":"01d82c67ac18ffc3","docTitle":"2404.03868_Extract_Define_Canonicalize_An_LLM_based_Framework_for_Knowledge_Graph","page":4,"quote":"Using our example above, the prompt is: OIE Prompt Given a piece of text, extract relational triplets in the form of [Subject, Relation, Object] from it."},{"id":"c19","chunkId":"743155d9b0541c99_c_f02eb32a3c5fe618","docId":"743155d9b0541c99","docTitle":"2401.15391_MultiHop_RAG_Benchmarking_Retrieval_Augmented_Generation_for_Multi_Hop","page":4,"quote":"For each type of query, we feed the claim set to GPT-4 and prompt it with an instruction to generate a query with information from each claim."},{"id":"c20","chunkId":"730f1a9f38d16689_c_c49e8c1f5d24c839","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":16,"quote":"Graph-toolformer: To empower llms with graph reasoning ability via prompt augmented by chatgpt."},{"id":"c21","chunkId":"6c24762a3f277fd1_c_cc79e93d101b5b2c","docId":"6c24762a3f277fd1","docTitle":"2309.15217_Ragas_Automated_Evaluation_of_Retrieval_Augmented_Generation","page":3,"quote":"To estimate answer relevance, for the given answer as(q), we prompt the LLM to generate n potential questions qi based on as(q), as follows: Generate a question for the given answer."},{"id":"c22","chunkId":"396a0fadeb4cd40f_c_6c116d647bbfcc05","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":5,"quote":"Prompt engineering leverages a model’s inherent capabilities with minimum necessity for external knowledge and model adaption."},{"id":"c23","chunkId":"ac529ab762fd1672_c_45b8552b58ce32ca","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":3,"quote":"Here we first write a prompt to clean the data and then write another prompt in the second stage to create knowledge triplets along with metadata."},{"id":"c24","chunkId":"730f1a9f38d16689_c_49909d6a6c4b2105","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":2,"quote":"The query and retrieved records populate a prompt template, which is then passed to the LLM (Ram et al., 2023)."},{"id":"c25","chunkId":"6c24762a3f277fd1_c_4db0d3446b205e0b","docId":"6c24762a3f277fd1","docTitle":"2309.15217_Ragas_Automated_Evaluation_of_Retrieval_Augmented_Generation","page":3,"quote":"We use the following prompt for this step3: Given a question and answer, create one or more statements from each sentence in the given answer."},{"id":"c26","chunkId":"6c24762a3f277fd1_c_4db0d3446b205e0b","docId":"6c24762a3f277fd1","docTitle":"2309.15217_Ragas_Automated_Evaluation_of_Retrieval_Augmented_Generation","page":3,"quote":"This verification step is carried out using the following prompt: Consider the given context and following statements, then determine whether they are supported by the information present in the context."},{"id":"c27","chunkId":"737b0b8fe0aa8459_c_532122fabeccc90e","docId":"737b0b8fe0aa8459","docTitle":"2501.00309_Retrieval_Augmented_Generation_with_Graphs_GraphRAG","page":31,"quote":"Similarly, KG-Rank [484] combines the re-ranked triplets with the task prompt and inputs them into LLMs for answer generation."},{"id":"c28","chunkId":"14671c78fc7de99d_c_e2ab10a48622bc45","docId":"14671c78fc7de99d","docTitle":"2405.14831_HippoRAG_Neurobiologically_Inspired_Long_Term_Memory_for_Large_Languag","page":4,"quote":"We find that this two-step prompt configuration leads to an appropriate balance between generality and bias towards named entities."},{"id":"c29","chunkId":"730f1a9f38d16689_c_5ea00e487e23cca8","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":6,"quote":"3: procedure GENERATEQUESTIONS 4: Based on the corpus description, prompt the LLM to: 1."},{"id":"c30","chunkId":"396a0fadeb4cd40f_c_1656d3c7e7c96fa8","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":14,"quote":"This capability signifies that long-document question answering, previously reliant on RAG, can now incorporate the entire document directly into the prompt."},{"id":"c31","chunkId":"396a0fadeb4cd40f_c_ff1814eb2a0b5efa","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":4,"quote":"Re-ranking the retrieved information to relocate the most relevant content to the edges of the prompt is a key strategy."},{"id":"c32","chunkId":"6c24762a3f277fd1_c_406b010c9a057b34","docId":"6c24762a3f277fd1","docTitle":"2309.15217_Ragas_Automated_Evaluation_of_Retrieval_Augmented_Generation","page":2,"quote":"Re- markably, strong results can be obtained in this way, although it comes with the limitation of being sensitive to the design of the prompt."},{"id":"c33","chunkId":"01d82c67ac18ffc3_c_6940e750d78fc24e","docId":"01d82c67ac18ffc3","docTitle":"2404.03868_Extract_Define_Canonicalize_An_LLM_based_Framework_for_Knowledge_Graph","page":1,"quote":"A principal is- sue is that, in prior methods, the KG schema has to be included in the LLM prompt to gen- erate valid triplets; larger and more complex schemas easily exceed the LLMs’ context win- dow length."},{"id":"c34","chunkId":"14671c78fc7de99d_c_e2ab10a48622bc45","docId":"14671c78fc7de99d","docTitle":"2405.14831_HippoRAG_Neurobiologically_Inspired_Long_Term_Memory_for_Large_Languag","page":4,"quote":"We then add the named entities to the OpenIE prompt to extract the final triples, which also contain concepts (noun phrases) beyond named entities."},{"id":"c35","chunkId":"6c24762a3f277fd1_c_44cebd6677163336","docId":"6c24762a3f277fd1","docTitle":"2309.15217_Ragas_Automated_Evaluation_of_Retrieval_Augmented_Generation","page":1,"quote":"While the usefulness of retrieval-augmented strategies is clear, their implementation requires a significant amount of tuning, as the overall per- formance will be affected by the retrieval model, the considered corpus, the LM, or the"},{"id":"c36","chunkId":"737b0b8fe0aa8459_c_3169c306dc4be0d2","docId":"737b0b8fe0aa8459","docTitle":"2501.00309_Retrieval_Augmented_Generation_with_Graphs_GraphRAG","page":2,"quote":"When retrieved content includes complex graph structures with textual attributes, simply verbalizing the text of the subgraph and concatenating it into a prompt may obscure critical structural information."},{"id":"c37","chunkId":"743155d9b0541c99_c_63534c0e7dcbf97a","docId":"743155d9b0541c99","docTitle":"2401.15391_MultiHop_RAG_Benchmarking_Retrieval_Augmented_Generation_for_Multi_Hop","page":3,"quote":"The retrieved chunks, combined with the query and an optional prompt, are then fed into an LLM to generate a final answer, following the format: LLM(q, Rq, prompt) →answer."},{"id":"c38","chunkId":"975aa1fd3c1b6031_c_402ce444df1ce1dd","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":4,"quote":"We also tried to prompt ChatGPT to identify the retrieval relevance for comparison, but it underperforms as elaborated in Section 5.5."},{"id":"c39","chunkId":"ac529ab762fd1672_c_e32318e66b415c47","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":3,"quote":"Both the steps are execute