id":"long_form_generation","label":"long-form generations"},{"id":"rag_based_approach","label":"RAG-based approaches"}]},{"citationId":"c3","pages":[{"id":"biography","label":"Biography"},{"id":"corrective_retrieval_augmented_generation","label":"Corrective retrieval augmented generation"},{"id":"long_form_generation","label":"long-form generations"},{"id":"pop_qa","label":"PopQA"},{"id":"pub_health","label":"PubHealth"},{"id":"short_form_generation","label":"short-form generation"}]},{"citationId":"c26","pages":[{"id":"corrective_retrieval_augmented_generation","label":"Corrective retrieval augmented generation"},{"id":"self_correction","label":"self-correction"}]},{"citationId":"c11","pages":[{"id":"corrective_retrieval_augmented_generation","label":"Corrective retrieval augmented generation"},{"id":"long_form_generation","label":"long-form generations"}]},{"citationId":"c10","pages":[{"id":"correct","label":"Correct"},{"id":"corrective_retrieval_augmented_generation","label":"Corrective retrieval augmented generation"},{"id":"incorrect","label":"Incorrect"},{"id":"retrieval_evaluator","label":"retrieval evaluator"}]}],"mentions":[{"citationId":"c29"},{"citationId":"c30"},{"citationId":"c2"},{"citationId":"c21"},{"citationId":"c1"},{"citationId":"c31"},{"citationId":"c25"},{"citationId":"c32"},{"citationId":"c33"},{"citationId":"c26"}],"mentionsLeftOut":21,"citations":[{"id":"c1","chunkId":"396a0fadeb4cd40f_c_99fb2ebbbcfe5511","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":18,"quote":"Ling, “Corrective retrieval augmented generation,” arXiv preprint arXiv:2401.15884, 2024."},{"id":"c2","chunkId":"396a0fadeb4cd40f_c_013aaf543e6a823f","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":15,"quote":"For example, CRAG [67] trains a lightweight retrieval evaluator to assess the overall quality of the retrieved docu- ments for a query and triggers different knowledge retrieval actions based on confidence levels."},{"id":"c3","chunkId":"975aa1fd3c1b6031_c_0f69dd303c0dee26","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":6,"quote":"5.1 Tasks, Datasets and Metrics CRAG was evaluated on four datasets, including PopQA (Mallen et al., 2023) (short-form gener- ation), Biography (Min et al., 2023) (long-form generation), PubHealth (Zhang et al., 2023a) (true- or-false"},{"id":"c4","chunkId":"975aa1fd3c1b6031_c_412eb8faa6586cd7","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":6,"quote":"5.2 Baselines We primarily compared CRAG with both ap- proaches with and without retrieval, where the latter can be further split into standard RAG and latest advanced RAG, including: Baselines without retrieval."},{"id":"c5","chunkId":"975aa1fd3c1b6031_c_666c720003489c6c","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":8,"quote":"rios including short-form entity generation (PopQA), long-form generation (Bi- ography), and closed-set tasks (PubHealth, Arc- Challenge). These results verified the consistent effectiveness of CRAG."},{"id":"c6","chunkId":"975aa1fd3c1b6031_c_265190f138342ea0","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":10,"quote":"512 Self-RAG 26.5∼132.4 0.741 Self-CRAG 27.2∼80.2 0.908 Table 6: computational overhead assessment of RAG, CRAG, Self-CRAG, and Self-RAG about FLOPs per token on GPUs and executing time per instance."},{"id":"c7","chunkId":"975aa1fd3c1b6031_c_666c720003489c6c","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":8,"quote":"It can be seen that CRAG still showed competitive performance when the underlying LLMs was changed from SelfRAG-LLaMA2-7b to LLaMA2-hf-7b, while the performance of Self- RAG dropped significantly, even underperforming the standard RAG on"},{"id":"c8","chunkId":"975aa1fd3c1b6031_c_0f69dd303c0dee26","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":6,"quote":"5 Experiments We conducted experiments to extensively demon- strate CRAG’s adaptability to RAG-based ap- proaches and its generalizability across both short- and long-form generation tasks."},{"id":"c9","chunkId":"975aa1fd3c1b6031_c_582cfe0b42fdd34e","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":10,"quote":"While we primarily proposed to improve the RAG framework from a corrective perspective and CRAG can be seamlessly coupled with various RAG-based approaches, fine-tuning an external retrieval evaluator is inevitable."},{"id":"c10","chunkId":"975aa1fd3c1b6031_c_3a17d9e8221309cc","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":5,"quote":"Discussion Preliminary experiments of employ- ing only the Correct and Incorrect actions show that the efficacy of CRAG was easily affected by the accuracy of the retrieval evaluator."},{"id":"c11","chunkId":"975aa1fd3c1b6031_c_1bd5b2fabc3b50f5","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":2,"quote":"3) Experimental results extensively demonstrate CRAG’s adaptability to RAG-based approaches and its generalizability across short- and long-form generation tasks."},{"id":"c12","chunkId":"975aa1fd3c1b6031_c_e8d52739af596291","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":1,"quote":"Experiments on four datasets covering short- and long-form generation tasks show that CRAG can significantly improve the performance of RAG-based approaches."},{"id":"c13","chunkId":"975aa1fd3c1b6031_c_7dabedc7c1019ba1","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":5,"quote":"Discussion Preliminary experiments of employ- ing only the Correct and Incorrect actions show that the efficacy of CRAG was easily affected by the accuracy of the retrieval evaluator."},{"id":"c14","chunkId":"975aa1fd3c1b6031_c_6ea7de9df0aa688d","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":4,"quote":"Algorithm 1: CRAG Inference Require :E (Retrieval Evaluator), W (Query Rewriter), G (Generator) Input :x (Input question), D = {d1, d2, ..., dk} (Retrieved documents) Output :y (Generated response) 1 scorei = E evaluates the relevance of"},{"id":"c15","chunkId":"975aa1fd3c1b6031_c_0c5b2b8dc541c2a5","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":8,"quote":"These results demonstrated the adaptability of CRAG which is plug-and-play and can be implemented into RAG-based approaches."},{"id":"c16","chunkId":"975aa1fd3c1b6031_c_eb84534601e72a66","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":15,"quote":"Generator: As CRAG is a plug-and-play method, all generation models that can be uti- lized in RAG fit our approach as well. To be consistent with baselines for comparison, we adopted LLaMA2 (Touvron et al., 2023b) for the generation."},{"id":"c17","chunkId":"975aa1fd3c1b6031_c_fe48eb62518a378b","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":15,"quote":"Self-CRAG: To demonstrate that our plug-and- play approach can be utilized in other concurrent studies, we specifically designed to insert our CRAG into the Self-RAG (Asai et al., 2024) framework and named it Self-CRAG."},{"id":"c18","chunkId":"975aa1fd3c1b6031_c_a145a85fa5e95149","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":6,"quote":"In CRAG, a public and accessible commercial web search API is adopted to generate a series of URL links for every query."},{"id":"c19","chunkId":"975aa1fd3c1b6031_c_07ea5d32230087ac","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":10,"quote":"With the further leverage of web search and optimized knowledge utilization, CRAG has significantly improved the ability of automatic self-correction and efficient utilization of retrieved documents."},{"id":"c20","chunkId":"975aa1fd3c1b6031_c_d4fa8b0155abc356","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":1,"quote":"To this end, we propose the Corrective Retrieval Augmented Generation (CRAG) to improve the robustness of generation."},{"id":"c21","chunkId":"975aa1fd3c1b6031_c_e8d52739af596291","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":1,"quote":"CRAG is plug-and-play and can be seamlessly coupled with various RAG-based approaches."},{"id":"c22","chunkId":"975aa1fd3c1b6031_c_c2b7612d1760e95d","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":7,"quote":"The model coupling the proposed method with standard RAG is named CRAG and that coupling with Self- RAG is named Self-CRAG."},{"id":"c23","chunkId":"975aa1fd3c1b6031_c_666c720003489c6c","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":8,"quote":"As you can imagine, when more advanced LLMs are available in the future, they can be coupled with CRAG easily, while additional instruction tuning is still necessary for Self-RAG."},{"id":"c24","chunkId":"975aa1fd3c1b6031_c_d27d374849b1a85a","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":3,"quote":"4 CRAG 4.1 Overview of Model Inference Figure 2 and Algorithm 1 present an overview of CRAG at inference, which designs corrective strategies to improve the robustness of generation."},{"id":"c25","chunkId":"975aa1fd3c1b6031_c_f8cbee80a6da657d","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":1,"quote":"A method named Corrective Retrieval-Augmented Generation (CRAG) is proposed to self-correct the results of retriever and improve the utilization of documents for augmenting generation."},{"id":"c26","chunkId":"975aa1fd3c1b6031_c_1bd5b2fabc3b50f5","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":2,"quote":"2) A plug-and-play method named CRAG is proposed to improve the ability of automatic self-correction and efficient utilization of retrieved documents."},{"id":"c27","chunkId":"975aa1fd3c1b6031_c_07ea5d32230087ac","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":10,"quote":"Corrective Retrieval Augmented Generation is proposed to improve the robustness of generation."},{"id":"c28","chunkId":"975aa1fd3c1b6031_c_0c5b2b8dc541c2a5","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":8,"quote":"These results verified the consistent effectiveness of CRAG."},{"id":"c29","chunkId":"396a0fadeb4cd40f_c_d05df48cd481ca81","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":6,"quote":"RAG [54] FactoidWiki Text Chunk Inference Once IAG [55] Search Engine,Wikipedia Text Chunk Inference Once NoMIRACL [56] Wikipedia Text Chunk Inference Once ToC [57] Search Engine,Wikipedia Text Chunk Inference Recursive SKR [58]"},{"id":"c30","chunkId":"975aa1fd3c1b6031_c_d4fa8b0155abc356","docId":"975aa1fd3c1b6031","docTitle":"2401.15884_Corrective_Retrieval_Augmented_Generation","page":1,"quote":"Corrective Retrieval Augmented Generation Shi-Qi Yan1*, Jia-Chen Gu2*, Yun Zhu3, Zhen-Hua Ling1 1National Engineering Research Center of Speech and Language Information Processing, University of Science and Technology of China, Hefei,"},{"id":"c31","chunkId":"975aa1fd3c1b6031_c_29b186ec94bf67ad","docId":"975aa