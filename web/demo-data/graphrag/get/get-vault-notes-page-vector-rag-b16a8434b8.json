recision","label":"Context Precision"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c27","passages":2},{"other":{"id":"dataset","label":"dataset"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c7","passages":2},{"other":{"id":"external_document","label":"external documents"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c26","passages":2},{"other":{"id":"faithfulness","label":"Faithfulness"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c28","passages":2},{"other":{"id":"metadata","label":"metadata"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c29","passages":2},{"other":{"id":"metric","label":"metrics"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c8","passages":2},{"other":{"id":"large_language_model","label":"open information extractors"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c7","passages":2}],"linksLeftOut":22,"claims":[{"citationId":"c11","pages":[{"id":"comprehensiveness","label":"comprehensiveness"},{"id":"diversity","label":"Diversity"},{"id":"global_approach","label":"global approaches"},{"id":"vector_rag","label":"VectorRAG"}]},{"citationId":"c30","pages":[{"id":"empowerment","label":"empowerment"},{"id":"global_approach","label":"global approaches"},{"id":"graph_based_retrieval_augmented_generation","label":"Self-Reflective Retrieval-Augmented Generation"},{"id":"source_text_summarization","label":"source text summarization"},{"id":"vector_rag","label":"VectorRAG"}]},{"citationId":"c18","pages":[{"id":"directness","label":"directness"},{"id":"vector_rag","label":"VectorRAG"}]},{"citationId":"c31","pages":[{"id":"graph_based_retrieval_augmented_generation","label":"Self-Reflective Retrieval-Augmented Generation"},{"id":"vector_rag","label":"VectorRAG"}]},{"citationId":"c32","pages":[{"id":"graph_based_retrieval_augmented_generation","label":"Self-Reflective Retrieval-Augmented Generation"},{"id":"map_reduce","label":"map-reduce"},{"id":"source_text","label":"source texts"},{"id":"text_summarization","label":"text summarization"},{"id":"vector_rag","label":"VectorRAG"}]},{"citationId":"c33","pages":[{"id":"entity_based_graph_index","label":"entity-based graph index"},{"id":"graph_based_retrieval_augmented_generation","label":"Self-Reflective Retrieval-Augmented Generation"},{"id":"vector_rag","label":"VectorRAG"}]},{"citationId":"c34","pages":[{"id":"graph_based_retrieval_augmented_generation","label":"Self-Reflective Retrieval-Augmented Generation"},{"id":"vector_rag","label":"VectorRAG"}]},{"citationId":"c5","pages":[{"id":"gpt4","label":"gpt-4-0314"},{"id":"graph_based_retrieval_augmented_generation","label":"Self-Reflective Retrieval-Augmented Generation"},{"id":"large_language_model","label":"open information extractors"},{"id":"vector_rag","label":"VectorRAG"}]},{"citationId":"c6","pages":[{"id":"graph_based_retrieval_augmented_generation","label":"Self-Reflective Retrieval-Augmented Generation"},{"id":"vector_rag","label":"VectorRAG"}]},{"citationId":"c9","pages":[{"id":"graph_based_retrieval_augmented_generation","label":"Self-Reflective Retrieval-Augmented Generation"},{"id":"vector_rag","label":"VectorRAG"}]}],"mentions":[{"citationId":"c35"},{"citationId":"c22"},{"citationId":"c10"},{"citationId":"c36"},{"citationId":"c29"},{"citationId":"c37"},{"citationId":"c26"},{"citationId":"c38"},{"citationId":"c39"},{"citationId":"c24"}],"mentionsLeftOut":26,"citations":[{"id":"c1","chunkId":"ac529ab762fd1672_c_dd3d9fcf161d857e","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":1,"quote":"We introduce a novel approach based on a combination, called HybridRAG, of the Knowledge Graphs (KGs) based RAG techniques (called GraphRAG) and VectorRAG techniques to enhance question-answer (Q&A) systems for infor- mation extraction"},{"id":"c2","chunkId":"730f1a9f38d16689_c_855fd3f62d583391","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":3,"quote":"However, these benchmarks are oriented towards vector RAG performance, i.e., they evaluate performance on explicit fact retrieval."},{"id":"c3","chunkId":"ac529ab762fd1672_c_465b7d57f719427a","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":7,"quote":"The relatively lower context precision observed for HybridRAG (0.79) can be attributed to its unique approach of combining con- texts from both VectorRAG and GraphRAG methods."},{"id":"c4","chunkId":"ac529ab762fd1672_c_465b7d57f719427a","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":7,"quote":"Furthermore, HybridRAG emerges as the most balanced and effective approach, outperforming both VectorRAG and GraphRAG in key metrics such as faithfulness and answer relevancy, while maintaining high context recall."},{"id":"c5","chunkId":"730f1a9f38d16689_c_49909d6a6c4b2105","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":2,"quote":"Results show GraphRAG strongly outperforms vector RAG when using GPT-4 as the LLM."},{"id":"c6","chunkId":"730f1a9f38d16689_c_4b9c7ced60e8992a","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":12,"quote":"Compared to vector RAG, however, GraphRAG shows promise as a way to mitigate these downstream risks for questions of a global nature, which might otherwise be answered by samples of retrieved facts falsely presented as global"},{"id":"c7","chunkId":"ac529ab762fd1672_c_0a1fbb25a9893c61","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":2,"quote":"2.1 VectorRAG The traditional RAG [9] process begins with a query that is related to the information possessed within external document(s) that are not a part of the training dataset for the LLM."},{"id":"c8","chunkId":"ac529ab762fd1672_c_158618a8e274bbce","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":4,"quote":"2.4 Evaluation Metrics To assess the efficacy of this integrated approach, we conducted a comparative analysis among the three approaches in a controlled ex- perimental set up: VectorRAG, GraphRAG and HybridRAG."},{"id":"c9","chunkId":"730f1a9f38d16689_c_4e7880c9886117d5","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":2,"quote":"The challenge, however, arises when the volume of data requires a RAG approach, since vector RAG approaches are unable to support sensemaking over an entire corpus."},{"id":"c10","chunkId":"ac529ab762fd1672_c_9b547c3112507803","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":1,"quote":"VectorRAG (the traditional RAG techniques that are based on vector databases) focuses on improving Natural Language Processing (NLP) tasks by retrieving relevant textual information to support the generation tasks."},{"id":"c11","chunkId":"730f1a9f38d16689_c_1a53944ac87861a0","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":9,"quote":"As shown in Figure 2 and Table 6, global approaches signifi- cantly outperformed conventional vector RAG (SS) in both comprehensiveness and diversity criteria across datasets."},{"id":"c12","chunkId":"730f1a9f38d16689_c_addd60c11790d5d2","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":2,"quote":"However, vector RAG approaches do not support sensemaking queries, meaning queries that require global understanding of the entire dataset, such as ”What are the key trends in how scientific discoveries are influenced by interdisciplinary"},{"id":"c13","chunkId":"730f1a9f38d16689_c_bc0397130f249f34","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":10,"quote":"For both the News and Podcast datasets, all global search conditions (C0-C3) and source text summarization (TS) had greater comprehensiveness than vector RAG (SS)."},{"id":"c14","chunkId":"ac529ab762fd1672_c_eb374f7d2abc0239","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":7,"quote":"And VectorRAG does better in abstractive questions where information is not explicitly mentioned in the raw data."},{"id":"c15","chunkId":"ac529ab762fd1672_c_eb374f7d2abc0239","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":7,"quote":"Overall GraphRAG performs better in extractive questions com- pared to VectorRAG."},{"id":"c16","chunkId":"730f1a9f38d16689_c_086f8765c281ae00","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":4,"quote":"generated texts such as “fluency” (Wang et al., 2023a) Some of these criteria are generic to vector RAG systems and not relevant to global sensemaking, such as “context relevance”, “faithfulness”, and “answer relevance” (RAGAS, Es et al."},{"id":"c17","chunkId":"730f1a9f38d16689_c_bc0397130f249f34","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":10,"quote":"nt method for the iterative question answering that characterizes sensemaking activity, while retaining advantages in comprehensiveness (72% win rate) and diversity (62% win rate) over vector RAG."},{"id":"c18","chunkId":"730f1a9f38d16689_c_1a53944ac87861a0","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":9,"quote":"Our use of directness as a validity test confirmed that vector RAG produces the most direct responses across all comparisons."},{"id":"c19","chunkId":"ac529ab762fd1672_c_580ecbe578bb2949","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":2,"quote":"1.1 Prior Work and Our Contribution VectorRAG has been extensively investigated in the recent years and focuses on enhancing NLP tasks by retrieving relevant textual information to support generation processes [9–11, 26]."},{"id":"c20","chunkId":"ac529ab762fd1672_c_d38c0a66ee716acf","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":8,"quote":"The HybridRAG system excels in faithfulness, answer relevancy, and context recall, demonstrating the benefits of inte- grating contexts from both VectorRAG and GraphRAG methods, despite potential trade-offs in context precision."},{"id":"c21","chunkId":"ac529ab762fd1672_c_2d3e81f1878b7c8e","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":6,"quote":"p 0 Maximum Output Tokens 1024 Chunks for Similarity Algorithm 20 Number of Context Retrieved 4 Table 3: VectorRAG Configuration 7https://www.pinecone.io/ The Q&A pipeline is constructed using the LangChain frame- work8."},{"id":"c22","chunkId":"ac529ab762fd1672_c_dd3d9fcf161d857e","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":1,"quote":"ration (RAG) (referred to as VectorRAG techniques which utilize vector databases for information retrieval) due to challenges such as domain specific terminology and complex formats of the documents."},{"id":"c23","chunkId":"ac529ab762fd1672_c_9b547c3112507803","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":1,"quote":"VectorRAG excels in situations where context from related textual documents is crucial for generating meaningful and coherent responses [9–11]."},{"id":"c24","chunkId":"ac529ab762fd1672_c_9d9741c7a3593924","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":3,"quote":"For the HybridRAG technique, we propose to integrate the aforementioned two distinct RAG techniques: Vec- torRAG and GraphRAG."},{"id":"c25","chunkId":"ac529ab762fd1672_c_91ccaaf2847d7a42","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":7,"quote":"Answer relevancy scores varied across the meth- ods, with HybridRAG outperforming the others at 0.96, followed by VectorRAG at 0.91, and GraphRAG at 0.89."},{"id":"c26","chunkId":"ac529ab762fd1672_c_63366a50187da7c6","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":2,"quote":"In traditional VectorRAG, the given external documents are di- vided into multiple chunks because of the limitation of context size of the language model."},{"id":"c27","chunkId":"ac529ab762fd1672_c_91ccaaf2847d7a42","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":7,"quote":"Context precision was highest for GraphRAG at 0.96, significantly surpassing Vec- torRAG (0.84) and HybridRAG (0.79)."},{"id":"c28","chunkId":"ac529ab762fd1672_c_91ccaaf2847d7a42","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":7,"quote":"In terms of Faithfulness, GraphRAG and HybridRAG demonstrated superior performance, both achieving a score of 0.96, while VectorRAG trailed slightly with a score of 0.94."},{"id":"c29","chunkId":"ac529ab762fd1672_c_1d3fb804c8623982","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":2,"quote":"Within our implementations of both VectorRAG GraphRAG techniques, we explicitly add information on the metadata of the documents that is also shown to improve the performance of VectorRAG [8]."},{"id":"c30","chunkId":"730f1a9f38d16689_c_1a53944ac87861a0","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":9,"quote":"Empowerment comparisons showed mixed results for both global approaches ver- sus vector RAG (SS) and GraphRAG approaches versus source text summarization (TS)."},{"id":"c31","chunkId":"730f1a9f38d16689_c_1d1cbe5e9ab22046","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":1,"quote":"This conventional approach, which we collectively call vector RAG, works well for queries that can be answered with information localized within a small set of records."},{"id":"c32","chunkId":"730f1a9f38d16689_c_27e0c041bd125213","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":8,"quote":"4.1.2 Conditions We compared six conditions including GraphRAG at four different graph community levels (C0, C1, C2, C3), a text summarization method that applies our map-reduce approach directly to source texts (TS), and a vector RAG"},{"id":"c33","chunkId":"730f1a9f38d16689_c_44f053f436c10451","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":12,"quote":"For situations requiring many global queries over the same dataset, summaries of root-level communities in the entity-based graph index provide a data index that is both superior to vector RAG and achieves competitive performance to other"},{"id":"c34","chunkId":"730f1a9f38d16689_c_44f053f436c10451","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":12,"quote":"Initial evaluations show substantial improvements over a vector RAG baseline for both the comprehensive- ness and diversity of answers, as well as favorable comparisons to a global but graph-free approach using map-reduce source text"},{"id":"c35","chunkId":"ac529ab762fd1672_c_755ad0b51856cc19","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":1,"quote":"New York, NY, USA ABSTRACT Extraction and interpretation of intricate information from unstruc- tured text data arising in financial applications, such as earnings call transcripts, present substantial challenges to large language models"},{"id":"c36","chunkId":"ac529ab762fd1672_c_580ecbe578bb2949","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":2,"quote":"In the present work, we propose a combination of VectorRAG and GraphRAG, called HybridRAG, to retrieve the relevant information from external documents for a given query to the LLM that brings advantages of both the RAGs together to"},{"id":"c37","chunkId":"ac529ab762fd1672_c_0a1fbb25a9893c61","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":2,"quote":"2 METHODOLOGY In this Section, we provide details of the proposed methodology by first discussing details of VectorRAG, then methodologies of constructing KGs from given documents and our proposed method- ology of GraphRAG and finally the"},{"id":"c38","chunkId":"ac529ab762fd1672_c_238eddf1321770b1","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":2,"quote":"The schematic diagram in Figure 1 provides details on the part of RAG that generates vector database from given external docu- ments in the traditional VectorRAG methodology where we also include explicit reference of metadata [8]."},{"id":"c39","chunkId":"ac529ab762fd1672_c_e32318e66b415c47","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":3,"quote":"A detailed discussion on imple- mentation of the methodology will be provided in Section 4.1 2.3 GraphRAG KG based RAG [22], or GraphRAG, also begins with a query based on the user’s input same as VectorRAG."}],"mastery":null}},{"type":"NotesGraph","id":"notes-graph","meta":{"status":"ready","error":null},"data":{"focusId":"vector_rag","query":"","nodes":[{"id":"vector_rag","label":"VectorRAG","kind":"method","passages":36,"documents":2,"degree":45,"mastery":null},{"id":"graph_based_retrieval_augmented_generation","label":"Self-Reflective Retrieval-Augmented Generation","kind":"method","passages":538,"documents":14,"degree":6