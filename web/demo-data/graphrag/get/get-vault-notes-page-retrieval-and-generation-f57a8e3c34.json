c12"},{"citationId":"c13"},{"citationId":"c14"},{"citationId":"c6"},{"citationId":"c1"}],"mentionsLeftOut":6,"citations":[{"id":"c1","chunkId":"ac529ab762fd1672_c_c2ba623cb00640d1","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":4,"quote":"These metrics though compare the final generated answers, do not necessarily directly evaluate the retrieval and generation parts separately."},{"id":"c2","chunkId":"14671c78fc7de99d_c_77febadcd6c2ca2b","docId":"14671c78fc7de99d","docTitle":"2405.14831_HippoRAG_Neurobiologically_Inspired_Long_Term_Memory_for_Large_Languag","page":9,"quote":"More sophisticated RAG methods, which perform multiple steps of retrieval and generation from an LLM, are even able to integrate information across new or updated knowledge elements[38, 64, 72, 78, 88, 90, 92], another crucial aspect of"},{"id":"c3","chunkId":"396a0fadeb4cd40f_c_9045661c1f5ab88c","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":3,"quote":"(Left) Naive RAG mainly consists of three parts: indexing, retrieval and generation."},{"id":"c4","chunkId":"396a0fadeb4cd40f_c_9045661c1f5ab88c","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":3,"quote":"The overall process is not limited to sequential retrieval and generation; it includes methods such as iterative and adaptive retrieval."},{"id":"c5","chunkId":"396a0fadeb4cd40f_c_1308fdf0c0219e76","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":12,"quote":"Additionally, both retrieval and generation quality assessments can be conducted through manual or automatic evaluation methods [29], [161], [163]."},{"id":"c6","chunkId":"8bbe93a93b05967d_c_81b89429614de17d","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":5,"quote":"Lack of Chunk Quality Measures As noted in Section 4, while the output chunks differed be- tween methods, retrieval and generation perfor- mances were similar across chunkers."},{"id":"c7","chunkId":"396a0fadeb4cd40f_c_18d9f568d1c19f4e","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":10,"quote":"(left) Iterative retrieval involves alternating between retrieval and generation, allowing for richer and more targeted context from the knowledge base at each step."},{"id":"c8","chunkId":"396a0fadeb4cd40f_c_18d9f568d1c19f4e","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":10,"quote":"(Middle) Recursive retrieval involves gradually refining the user query and breaking down the problem into sub-problems, then continuously solving complex problems through retrieval and generation."},{"id":"c9","chunkId":"737b0b8fe0aa8459_c_2919bbb40411f372","docId":"737b0b8fe0aa8459","docTitle":"2501.00309_Retrieval_Augmented_Generation_with_Graphs_GraphRAG","page":8,"quote":"Accurately recognizing the names and structures of entities in GraphRAG reduces cascading errors and provides a solid foundation for subsequent retrieval and generation steps."},{"id":"c10","chunkId":"8bbe93a93b05967d_c_f5edef1f89ea1d6d","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":1,"quote":"1 Introduction In Retrieval-Augmented Generation (RAG) sys- tems, cutting documents into smaller units called “chunks” has a crucial effect on the quality of both retrieval and generation tasks (Chen et al., 2023; Wadhwa et al., 2024; Shi"},{"id":"c11","chunkId":"ac529ab762fd1672_c_dd3d9fcf161d857e","docId":"ac529ab762fd1672","docTitle":"HybridRAG: Integrating Knowledge Graphs and Vector Retrieval Augmented Generation for Efficient Information Extraction","page":1,"quote":"Using experiments on a set of financial earning call transcripts documents which come in the form of Q&A format, and hence provide a natural set of pairs of ground-truth Q&As, we show that HybridRAG which retrieves context from both vector"},{"id":"c12","chunkId":"bd72eebf611df136_c_b915d5348eef3fa7","docId":"bd72eebf611df136","docTitle":"2410.05779_LightRAG_Simple_and_Fast_Retrieval_Augmented_Generation","page":10,"quote":"Overall, LightRAG excels in both efficiency and effectiveness, significantly improving the speed and quality of information retrieval and generation while reducing costs for LLM inference."},{"id":"c13","chunkId":"d9eaa1398abac0df_c_0e9bf113f0bf8d95","docId":"d9eaa1398abac0df","docTitle":"2310.11511_Self_RAG_Learning_to_Retrieve_Generate_and_Critique_through_Self_Refle","page":3,"quote":"Though our work also studies fine-grained critique on retrieval and generation, we train our target LM on task examples augmented with reflection tokens from a critic model offline, with a far lower training cost compared to RLHF."},{"id":"c14","chunkId":"396a0fadeb4cd40f_c_ff1814eb2a0b5efa","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":4,"quote":"The overall process is not limited to sequential retrieval and generation; it includes methods such as iterative and adaptive retrieval."}],"mastery":null}},{"type":"NotesGraph","id":"notes-graph","meta":{"status":"ready","error":null},"data":{"focusId":"retrieval_and_generation","query":"","nodes":[{"id":"retrieval_and_generation","label":"retrieval and generation","kind":"task","passages":16,"documents":7,"degree":18,"mastery":null},{"id":"graph_based_retrieval_augmented_generation","label":"Self-Reflective Retrieval-Augmented Generation","kind":"method","passages":538,"documents":14,"degree":638,"mastery":0.6},{"id":"retrieval","label":"retrieval","kind":"concept","passages":600,"documents":16,"degree":651,"maste