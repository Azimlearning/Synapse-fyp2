:{"id":"document_retrieval","label":"document retrieval"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c25","passages":2},{"other":{"id":"embedding_model","label":"embedding model"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c8","passages":2}],"linksLeftOut":82,"claims":[{"citationId":"c2","pages":[{"id":"chunk","label":"Chunks"},{"id":"community_summary","label":"community summaries"},{"id":"token_size","label":"token size"}]},{"citationId":"c26","pages":[{"id":"chunk","label":"Chunks"},{"id":"context_window","label":"context window"}]},{"citationId":"c27","pages":[{"id":"chunk","label":"Chunks"},{"id":"graph_based_retrieval_augmented_generation","label":"Self-Reflective Retrieval-Augmented Generation"},{"id":"large_language_model","label":"open information extractors"}]},{"citationId":"c28","pages":[{"id":"chunk","label":"Chunks"},{"id":"document","label":"Document"},{"id":"query_chunk_relevance","label":"query-chunk relevance"}]},{"citationId":"c29","pages":[{"id":"chunk","label":"Chunks"}]},{"citationId":"c21","pages":[{"id":"chunk","label":"Chunks"}]},{"citationId":"c24","pages":[{"id":"chunk","label":"Chunks"}]}],"mentions":[{"citationId":"c30"},{"citationId":"c31"},{"citationId":"c32"},{"citationId":"c33"},{"citationId":"c34"},{"citationId":"c35"},{"citationId":"c36"},{"citationId":"c37"},{"citationId":"c38"},{"citationId":"c15"}],"mentionsLeftOut":86,"citations":[{"id":"c1","chunkId":"396a0fadeb4cd40f_c_450923f637ca6f98","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":7,"quote":"In text, retrieval granularity ranges from fine to coarse, including Token, Phrase, Sentence, Proposition, Chunks, Doc- ument."},{"id":"c2","chunkId":"730f1a9f38d16689_c_f0465cc559c165ba","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":6,"quote":"Community summaries are randomly shuffled and divided into chunks of pre-specified token size."},{"id":"c3","chunkId":"396a0fadeb4cd40f_c_63b70d30e6c602f7","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":8,"quote":"1) Chunking Strategy: The most common method is to split the document into chunks on a fixed number of tokens (e.g., 100, 256, 512) [88]."},{"id":"c4","chunkId":"396a0fadeb4cd40f_c_5a8ae7af32a9d1fc","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":3,"quote":"The retrieval phase often struggles with precision and recall, leading to the selection of misaligned or irrelevant chunks, and the missing of crucial information."},{"id":"c5","chunkId":"8bbe93a93b05967d_c_f8a88345a7ca9bdb","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":1,"quote":"(a) Fixed-size Chunker splits the document into consecutive, uniform chunks without considering semantic content."},{"id":"c6","chunkId":"396a0fadeb4cd40f_c_05a521270f216026","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":3,"quote":"To accommodate the context limitations of language models, text is segmented into smaller, digestible chunks."},{"id":"c7","chunkId":"730f1a9f38d16689_c_02012b4621581282","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":4,"quote":"3.1.1 Source Documents →Text Chunks To start, the documents in the corpus are split into text chunks."},{"id":"c8","chunkId":"396a0fadeb4cd40f_c_05a521270f216026","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":3,"quote":"Chunks are then encoded into vector representations using an embedding model and stored in vector database."},{"id":"c9","chunkId":"396a0fadeb4cd40f_c_d13a7a33d897ce11","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":8,"quote":"File are arranged in parent- child relationships, with chunks linked to them."},{"id":"c10","chunkId":"396a0fadeb4cd40f_c_05a521270f216026","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":3,"quote":"Retrieve the Top k chunks most relevant to the question based on semantic similarity."},{"id":"c11","chunkId":"396a0fadeb4cd40f_c_3fa0659d7f419fcb","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":3,"quote":"It then computes the similarity scores between the query vector and the vector of chunks within the indexed corpus."},{"id":"c12","chunkId":"396a0fadeb4cd40f_c_d13a7a33d897ce11","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":8,"quote":"Data sum- maries are stored at each node, aiding in the swift traversal of data and assisting the RAG system in determining which chunks to extract."},{"id":"c13","chunkId":"743155d9b0541c99_c_63534c0e7dcbf97a","docId":"743155d9b0541c99","docTitle":"2401.15391_MultiHop_RAG_Benchmarking_Retrieval_Augmented_Generation_for_Multi_Hop","page":3,"quote":"Given a user query q, the system typi- cally retrieves the top-K chunks that best match the query."},{"id":"c14","chunkId":"396a0fadeb4cd40f_c_05a521270f216026","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":3,"quote":"Input the original question and the retrieved chunks together into LLM to generate the final answer."},{"id":"c15","chunkId":"396a0fadeb4cd40f_c_fab306facd5b5f68","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":2,"quote":"Documents are split into chunks, encoded into vectors, and stored in a vector database."},{"id":"c16","chunkId":"8bbe93a93b05967d_c_108c8edce74d164a","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":2,"quote":"Breakpoint-based Semantic Chunker A break- point-based chunker scans over the sequence of sentences and decide where to insert a breakpoint to separate sentences before and after it into two chunks."},{"id":"c17","chunkId":"396a0fadeb4cd40f_c_016839ec7be553a2","docId":"396a0fadeb4cd40f","docTitle":"2312.10997_Retrieval_Augmented_Generation_for_Large_Language_Models_A_Survey","page":9,"quote":"cosine similarity) between the embeddings of the ques- tion and document chunks, where the semantic representation capability of embedding models plays a key role."},{"id":"c18","chunkId":"8bbe93a93b05967d_c_3af9b0854c8045f7","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":3,"quote":"We measured the number of ground-truth evidence sentences present in the re- trieved top-k chunks."},{"id":"c19","chunkId":"8bbe93a93b05967d_c_d56682650895de7c","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":7,"quote":"To address challenges encountered during exper- imentation, we implemented the following adjust- ments: Chunk Size Constraint Without a size constraint, this chunker tends to form one large chunk while leaving a few isolated sentences as"},{"id":"c20","chunkId":"737b0b8fe0aa8459_c_63537c71a05dc247","docId":"737b0b8fe0aa8459","docTitle":"2501.00309_Retrieval_Augmented_Generation_with_Graphs_GraphRAG","page":3,"quote":"However, GraphRAG stores chunks as interconnected nodes with edges denoting their relations, which can benefit retrieval, organization, and generation."},{"id":"c21","chunkId":"8bbe93a93b05967d_c_366da0f5b6260812","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":7,"quote":"If set to 1, one sentence overlaps between consecutive chunks; if set to 0, there is no overlap."},{"id":"c22","chunkId":"730f1a9f38d16689_c_3865d5b1bc774563","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":6,"quote":"Community summaries are randomly shuffled and divided into chunks of pre-specified token size."},{"id":"c23","chunkId":"8bbe93a93b05967d_c_1cf0759a18d52fa5","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":3,"quote":"We randomly sampled 100 queries from each dataset and retrieved the top k chunks, where k ∈[1, 3, 5, 10]."},{"id":"c24","chunkId":"8bbe93a93b05967d_c_366da0f5b6260812","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":7,"quote":"Sentences were split into chunks when the distance between consecu- tive sentences exceeded a predefined threshold."},{"id":"c25","chunkId":"8bbe93a93b05967d_c_e5772b996828900d","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":10,"quote":"This has little effect on doc- ument retrieval since chunks are mapped to their source documents regardless of size."},{"id":"c26","chunkId":"730f1a9f38d16689_c_f0465cc559c165ba","docId":"730f1a9f38d16689","docTitle":"2404.16130_From_Local_to_Global_A_Graph_RAG_Approach_to_Query_Focused_Summarizati","page":6,"quote":"This ensures relevant information is distributed across chunks, rather than concentrated (and potentially lost) in a single context window."},{"id":"c27","chunkId":"737b0b8fe0aa8459_c_d971c5ad15387e76","docId":"737b0b8fe0aa8459","docTitle":"2501.00309_Retrieval_Augmented_Generation_with_Graphs_GraphRAG","page":19,"quote":"Graph-RAG [98] first divides each document into chunks and then uses an LLM to detect all the entities in each chunk, including their name, type, and description."},{"id":"c28","chunk