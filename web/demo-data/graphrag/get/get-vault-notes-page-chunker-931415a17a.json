on":null,"direction":null,"citationId":"c10","passages":1},{"other":{"id":"clustering_algorithm","label":"clustering algorithms"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c10","passages":1},{"other":{"id":"coherence","label":"coherence"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c6","passages":1},{"other":{"id":"data","label":"Data"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c20","passages":1},{"other":{"id":"dbscan_chunker","label":"DBSCAN chunker"},"kind":"co_mention","relation":null,"direction":null,"citationId":"c9","passages":1}],"linksLeftOut":13,"claims":[{"citationId":"c2","pages":[{"id":"chunker","label":"chunker"},{"id":"evidence_retrieval","label":"Evidence retrieval"}]},{"citationId":"c25","pages":[{"id":"answer_generation","label":"answer generation"},{"id":"chunker","label":"chunker"}]},{"citationId":"c26","pages":[{"id":"chunker","label":"chunker"}]},{"citationId":"c3","pages":[{"id":"answer_generation","label":"answer generation"},{"id":"chunker","label":"chunker"},{"id":"document_retrieval","label":"document retrieval"},{"id":"evidence_retrieval","label":"Evidence retrieval"}]},{"citationId":"c1","pages":[{"id":"chunker","label":"chunker"},{"id":"fixed_size_chunker","label":"Fixed-size Chunker"}]},{"citationId":"c4","pages":[{"id":"chunker","label":"chunker"},{"id":"document_retrieval","label":"document retrieval"},{"id":"document_stitching","label":"document stitching"}]},{"citationId":"c27","pages":[{"id":"chunker","label":"chunker"}]}],"mentions":[{"citationId":"c5"},{"citationId":"c14"},{"citationId":"c10"},{"citationId":"c1"},{"citationId":"c28"},{"citationId":"c17"},{"citationId":"c29"},{"citationId":"c22"},{"citationId":"c30"},{"citationId":"c31"}],"mentionsLeftOut":29,"citations":[{"id":"c1","chunkId":"8bbe93a93b05967d_c_523725d1f0094d60","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":2,"quote":"When λ = 0, the chunker operates purely based on semantic similarity; when λ = 1, it mirrors the Fixed-size Chunker."},{"id":"c2","chunkId":"8bbe93a93b05967d_c_3af9b0854c8045f7","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":3,"quote":"3.2 Evidence Retrieval Here we evaluate chunkers at a finer granularity than the previous experiment by measuring their abilities to locate evidence sentences."},{"id":"c3","chunkId":"8bbe93a93b05967d_c_523725d1f0094d60","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":2,"quote":"3 Experiments In the absence of ground-truth chunk data, we de- signed three experiments to indirectly assess the quality of each chunker: document retrieval, evi- dence retrieval, and answer generation."},{"id":"c4","chunkId":"8bbe93a93b05967d_c_5ce0cc847e090e6c","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":8,"quote":"C Document Stitching and Dataset Choices Most document retrieval datasets consist of short documents (fewer than 20 sentences), which are inadequate for effectively evaluating chunkers."},{"id":"c5","chunkId":"8bbe93a93b05967d_c_f8a88345a7ca9bdb","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":1,"quote":"(a) Fixed-size Chunker splits the document into consecutive, uniform chunks without considering semantic content."},{"id":"c6","chunkId":"8bbe93a93b05967d_c_f8a88345a7ca9bdb","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":1,"quote":"(b) Breakpoint-based Semantic Chunker segments the text by detecting semantic distance thresholds between consecutive sentences to maintain coherence."},{"id":"c7","chunkId":"8bbe93a93b05967d_c_f8a88345a7ca9bdb","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":1,"quote":"(c) Clustering-based Semantic Chunker groups semantically similar sentences, potentially combining non-consecutive text to form topic-based chunks."},{"id":"c8","chunkId":"8bbe93a93b05967d_c_d56682650895de7c","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":7,"quote":"To address challenges encountered during exper- imentation, we implemented the following adjust- ments: Chunk Size Constraint Without a size constraint, this chunker tends to form one large chunk while leaving a few isolated sentences as"},{"id":"c9","chunkId":"8bbe93a93b05967d_c_c2250bf43a3ca573","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":7,"quote":"For the DBSCAN chunker, we evaluated three hyperparameters: λ, similar to single-linkage; EPS, the maximum distance between two samples for them to be considered part of the same neighbor- hood; and \"min_samples\", the minimum number of"},{"id":"c10","chunkId":"8bbe93a93b05967d_c_24729fe8ea665697","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":2,"quote":"Clustering-based Semantic Chunker This type of chunkers leverage clustering algorithms to group sentences together semantically, capturing global relationships and allowing for non-sequential sen- tence groupings."},{"id":"c11","chunkId":"8bbe93a93b05967d_c_62420926b42495e1","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":11,"quote":"The Clustering-based Chunker made one error by grouping Sentence 16 (the last sentence of Doc- ument 4) into Chunk 2."},{"id":"c12","chunkId":"8bbe93a93b05967d_c_9e8e482cc4774faa","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":10,"quote":"Clustering-based Semantic Chunker (DBSCAN) As EPS increases, the threshold for grouping sam- ples into the same cluster loosens, increasing av- erage chunk size."},{"id":"c13","chunkId":"8bbe93a93b05967d_c_267bb9040788f52b","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":4,"quote":"4.3 Evidence Retrieval As shown in Table 2, Fixed-size Chunker per- formed best on 3 out of 5 datasets, indicating a slight edge in capturing core evidence sentences."},{"id":"c14","chunkId":"8bbe93a93b05967d_c_108c8edce74d164a","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":2,"quote":"Breakpoint-based Semantic Chunker A break- point-based chunker scans over the sequence of sentences and decide where to insert a breakpoint to separate sentences before and after it into two chunks."},{"id":"c15","chunkId":"8bbe93a93b05967d_c_267bb9040788f52b","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":4,"quote":"However, the performance differences between the Fixed-size Chunker and the two semantic chunkers were minimal, suggesting no clear advantage for any specific chunking strategy."},{"id":"c16","chunkId":"8bbe93a93b05967d_c_e5772b996828900d","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":10,"quote":"Clustering-based Semantic Chunker (Single- linkage) As n_clusters increases, the average chunk size decreases."},{"id":"c17","chunkId":"8bbe93a93b05967d_c_181c8bf27b0b14b3","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":3,"quote":"For each dataset, results are reported based on the best hyperparameter configuration for each chunker, determined by the average F1 score across all k values."},{"id":"c18","chunkId":"8bbe93a93b05967d_c_ac39d168a20f05cd","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":9,"quote":"For example, \"No Chunker\" will con- sistently have the highest recall and lowest preci- sion, as it treats entire documents as single chunks."},{"id":"c19","chunkId":"8bbe93a93b05967d_c_ac39d168a20f05cd","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":9,"quote":"The F1 score helps balance these biases, providing a better indicator of whether the chunker produces appropriately sized chunks that capture relevant ev- idence."},{"id":"c20","chunkId":"8bbe93a93b05967d_c_267bb9040788f52b","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":4,"quote":"These results suggest that in real life, the topics in a document may not be as diverse as in our artificially noisy, stitched data, and hence semantic chunkers may not have an edge over fixed-size chunker there."},{"id":"c21","chunkId":"8bbe93a93b05967d_c_c0c23ec7486789bd","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":11,"quote":"The Fixed-size Chunker repeated its issue from stitched documents, occasionally grouping sentences from adjacent sections into the same chunk, and this er- ror could be easily fixed by splitting the document by sections beforehand."},{"id":"c22","chunkId":"8bbe93a93b05967d_c_1b8901389590dda9","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":3,"quote":"In such cases, Breakpoint-based Semantic Chunker outperformed others by better preserving topic integrity, splitting sentences based on semantic dissimilarity to form chunks similar to the original documents."},{"id":"c23","chunkId":"8bbe93a93b05967d_c_366da0f5b6260812","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":7,"quote":"Breakpoint-based Semantic Chunker We tested two hyperparameters: the type of breakpoint thresh- old and the threshold amount."},{"id":"c24","chunkId":"8bbe93a93b05967d_c_0bbe8107207d6466","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":11,"quote":"Without considering posi- tional structure like the Fixed-size and Breakpoint- based Chunkers, the Clustering-based Chunker often mixed sentences from different documents."},{"id":"c25","chunkId":"8bbe93a93b05967d_c_3af9b0854c8045f7","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":3,"quote":"3.3 Answer Generation This experiment measured how chunkers impacted the quality of LLM-generated answers."},{"id":"c26","chunkId":"8bbe93a93b05967d_c_40b5abbf99c43c4e","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":17,"quote":"The configuration listed next to each chunker name represents the optimal setup for minimizing errors."},{"id":"c27","chunkId":"8bbe93a93b05967d_c_5ce0cc847e090e6c","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":8,"quote":"Short documents lack the complex- ity required to assess how chunkers manage context and semantic coherence across longer spans of text."},{"id":"c28","chunkId":"8bbe93a93b05967d_c_1cf0759a18d52fa5","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":3,"quote":"each chunker: document retrieval, evi- dence retrieval, and answer generation."},{"id":"c29","chunkId":"8bbe93a93b05967d_c_fc69e0b6eebd261b","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":3,"quote":"For each dataset, results are reported based on the best hyperparameter configuration for each chunker, determined by the average F1 score across all k values."},{"id":"c30","chunkId":"8bbe93a93b05967d_c_267bb9040788f52b","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":4,"quote":"This diminished the advantage of Breakpoint-based Semantic Chunker, while Clustering-based Seman- tic Chunker improved."},{"id":"c31","chunkId":"8bbe93a93b05967d_c_b30d80c76bcfd4a7","docId":"8bbe93a93b05967d","docTitle":"2410.13070_Is_Semantic_Chunking_Worth_the_Computational_Cost","page":4,"quote":"However, the performance differences between the Fixed-size Chunker and the two semantic chunkers were minimal, suggesting no clear advantage for any specific chunking strategy."}],"mastery":null}},{"type":"NotesGraph","id":"notes-graph","meta":{"status":"ready","error":null},"data":{"focusId":"chunker","query":"","nodes":[{"id":"chunker","label":"chunker","kind":"concept","passages":39,"documents":1,"degree":51,"mastery":null},{"id":"fixed_size_chunker","label":"Fixed-size Chunker","kind":"method","passages":19,"documents":1,"degree":25,"mastery":null},{"id":"evidence_retrieval","label":"Evidence retrieval","kind":"task","passages":24,"documents":3,"degree":20,"mastery":null},{"id":"answer_generation","label":"answer generation","kind":"task","passages":29,"documents":8,"degree":28,"mastery":null},{"id":"document_retrieval","label":"document retrieval","kind":"task","passages":26,"documents":6,"degree":29,"mastery":null},{"id":"document_stitching","label":"document stitching","kind":"method","passages":1,"documents":1,"degree":5,"mastery":null},{"id":"fixed_size","label":"Fixed-size","kind":"method","passages":28,"documents":1,"degree":34,"mastery":null},{"id":"chunk","label":"Chunks","kind":"concept","passages":96,"documents":9,"degree":120,"mastery":null},{"id":"clustering_based_semantic_chunker","label":"Clustering-based Semantic Chunker","kind":"method","passages":10,"documents":1,"degree":13,"mastery":null},{"id":"breakpoint_based_semantic_chunker","label":"Breakpoint-based Semantic Chunker","kind":"method","passages":8,"documents":1,"degree":15,"mastery":null},{"id":"chunk_size","label":"chunk size","kind":"concept","passages":16,"documents":5,"degree":33,"mastery":null},{"id":"document","label":"Document","kind":"co